# Keep the Docker build context small and host-independent.
.git/
.github/
.devcontainer/
.cursor/
.claude/

# Local model weights and vendored reference repos are never baked into an image.
model/
refs/
devdoc/

# Python / Rust build artifacts are rebuilt inside the image.
.venv/
venv/
build/
dist/
*.egg-info/
*.so
*.whl
rust/target/
**/__pycache__/
**/*.py[cod]
.pytest_cache/
.ruff_cache/
.tp_cache/
.mypy_cache/
.codegraph/

# Not needed by the published runtime image.
tests/
scripts/
docs/
*.swp
